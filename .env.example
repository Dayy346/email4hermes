# Copy to .env and fill in your values.
APP_NAME=Email Assistant
APP_ENV=dev
LOG_LEVEL=INFO
DEFAULT_FROM_EMAIL=you@example.com
EMAIL_BACKEND=demo
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/calendar.events
GOOGLE_ACCOUNT_EMAIL=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
# Set EMAIL_BACKEND=gmail after GOOGLE_REFRESH_TOKEN is set for live collect/send.
